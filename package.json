{
  "name": "vscode-agent-panel",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.88",
  "publisher": "DonkovtsevArthur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DonkovtsevArthur/agent_panel.git"
  },
  "bugs": {
    "url": "https://github.com/DonkovtsevArthur/agent_panel/issues"
  },
  "homepage": "https://github.com/DonkovtsevArthur/agent_panel#readme",
  "icon": "media/icon-marketplace.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:agentPanel.chat",
    "onCommand:agentPanel.open",
    "onCommand:agentPanel.openSettings",
    "onCommand:agentPanel.newChat",
    "onCommand:agentPanel.clearChat",
    "onCommand:agentPanel.addSelectionToChat",
    "onCommand:agentPanel.addSelectionToNewChat",
    "onCommand:agentPanel.generateCommitMessage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentPanel",
          "title": "%viewsContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentPanel": [
        {
          "type": "webview",
          "id": "agentPanel.chat",
          "name": "%view.name%",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "agentPanel.open",
        "title": "%command.open.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.openSettings",
        "title": "%command.openSettings.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.newChat",
        "title": "%command.newAgent.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.clearChat",
        "title": "%command.clearChat.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.pickAttachments",
        "title": "%command.attachFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.addSelectionToChat",
        "title": "%command.addSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.addSelectionToNewChat",
        "title": "%command.addSelectionToNewChat.title%",
        "category": "%command.category%"
      },
      {
        "command": "agentPanel.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "%command.category%",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentPanel.open"
        },
        {
          "command": "agentPanel.openSettings"
        },
        {
          "command": "agentPanel.newChat"
        },
        {
          "command": "agentPanel.addSelectionToChat",
          "when": "editorHasSelection"
        },
        {
          "command": "agentPanel.addSelectionToNewChat",
          "when": "editorHasSelection"
        },
        {
          "command": "agentPanel.generateCommitMessage"
        }
      ],
      "editor/context": [
        {
          "command": "agentPanel.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "navigation@9"
        },
        {
          "command": "agentPanel.addSelectionToNewChat",
          "when": "editorHasSelection",
          "group": "navigation@10"
        }
      ],
      "scm/title": [
        {
          "command": "agentPanel.generateCommitMessage",
          "when": "scmProvider == git || gitOpenRepositoryCount > 0",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentPanel.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "agentPanel.addSelectionToNewChat",
        "key": "ctrl+alt+shift+l",
        "mac": "cmd+alt+shift+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agentPanel.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.en%",
            "%config.language.enum.ru%"
          ],
          "description": "%config.language.description%"
        },
        "agentPanel.baseUrl": {
          "type": "string",
          "default": "https://ai-platform.kube.severstal.severstalgroup.com/openai",
          "description": "%config.baseUrl.description%"
        },
        "agentPanel.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%"
        },
        "agentPanel.providers": {
          "type": "array",
          "default": [],
          "description": "%config.providers.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.providers.id.description%"
              },
              "name": {
                "type": "string",
                "description": "%config.providers.name.description%"
              },
              "baseUrl": {
                "type": "string",
                "description": "%config.providers.baseUrl.description%"
              },
              "statusUrl": {
                "type": "string",
                "default": "",
                "description": "%config.providers.statusUrl.description%"
              },
              "apiKey": {
                "type": "string",
                "description": "%config.providers.apiKey.description%"
              }
            }
          }
        },
        "agentPanel.models": {
          "type": "array",
          "default": [
            {
              "id": "DeepSeek-V4-Flash",
              "label": "DeepSeek V4 Flash"
            },
            {
              "id": "Qwen3-Coder-Next",
              "label": "Qwen3 Coder Next"
            },
            {
              "id": "Gemma-4-31b",
              "label": "Gemma 4 31B"
            },
            {
              "id": "claude-sonnet-4-5",
              "label": "Claude Sonnet 4.5"
            },
            {
              "id": "gpt-4.1",
              "label": "GPT-4.1"
            },
            {
              "id": "Gemini 2.5 Flash",
              "label": "Gemini 2.5 Flash"
            }
          ],
          "description": "%config.models.description%",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.models.id.description%"
              },
              "label": {
                "type": "string",
                "description": "%config.models.label.description%"
              },
              "providerId": {
                "type": "string",
                "description": "%config.models.providerId.description%"
              },
              "contextWindow": {
                "type": "number",
                "minimum": 1024,
                "description": "%config.models.contextWindow.description%"
              },
              "maxOutputTokens": {
                "type": "number",
                "minimum": 1,
                "description": "%config.models.maxOutputTokens.description%"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "%config.models.enabled.description%"
              },
              "favorite": {
                "type": "boolean",
                "default": false,
                "description": "%config.models.favorite.description%"
              },
              "supportsVision": {
                "type": "boolean",
                "description": "%config.models.supportsVision.description%"
              }
            }
          }
        },
        "agentPanel.defaultModel": {
          "type": "string",
          "default": "DeepSeek-V4-Flash",
          "description": "%config.defaultModel.description%"
        },
        "agentPanel.defaultContextWindow": {
          "type": "number",
          "default": 128000,
          "minimum": 1024,
          "description": "%config.defaultContextWindow.description%"
        },
        "agentPanel.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "%config.systemPrompt.description%"
        },
        "agentPanel.modes": {
          "type": "array",
          "default": [],
          "description": "%config.modes.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "tools": {
                "type": "string",
                "enum": [
                  "agent",
                  "readonly"
                ],
                "default": "agent"
              },
              "prompt": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "agentPanel.maxToolRounds": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 60,
          "description": "%config.maxToolRounds.description%"
        },
        "agentPanel.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 64,
          "maximum": 128000,
          "description": "%config.maxTokens.description%"
        },
        "agentPanel.visionRouting.preferredModelIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%config.visionRouting.preferredModelIds.description%"
        },
        "agentPanel.visionRouting.preferredModelId": {
          "type": "string",
          "default": "",
          "description": "%config.visionRouting.preferredModelId.description%",
          "deprecationMessage": "Use agentPanel.visionRouting.preferredModelIds"
        },
        "agentPanel.maxResponseChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "%config.maxResponseChars.description%"
        },
        "agentPanel.soundNotifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.soundNotifications.enabled.description%"
        },
        "agentPanel.rejectUnauthorized": {
          "type": "boolean",
          "default": false,
          "description": "%config.rejectUnauthorized.description%"
        },
        "agentPanel.caBundlePath": {
          "type": "string",
          "default": "~/Documents/Cline/severstal-ca-bundle.pem",
          "description": "%config.caBundlePath.description%"
        },
        "agentPanel.commitMessage.prompt": {
          "type": "string",
          "default": "",
          "description": "%config.commitMessage.prompt.description%"
        },
        "agentPanel.commitMessage.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "%config.commitMessage.language.enum.auto%",
            "%config.commitMessage.language.enum.en%",
            "%config.commitMessage.language.enum.ru%"
          ],
          "description": "%config.commitMessage.language.description%"
        },
        "agentPanel.figma.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.figma.enabled.description%"
        },
        "agentPanel.mcp.servers": {
          "type": "array",
          "default": [],
          "description": "%config.mcp.servers.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "transport"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/bundle-mcp.js",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "package": "vsce package",
    "test": "npm run compile && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^15.0.12",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  }
}
