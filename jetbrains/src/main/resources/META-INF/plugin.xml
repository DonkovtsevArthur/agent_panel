<idea-plugin>
  <id>com.harbor.agents</id>
  <name>Harbor Agents</name>
  <vendor email="donkovtsev.arthur@gmail.com" url="https://github.com/DonkovtsevArthur/agent_panel">Harbor Agents</vendor>

  <description><![CDATA[
    <p><b>Harbor Agents</b> (Гавань агентов) — локальная панель AI-агента для WebStorm / IntelliJ.
    Подключаете свой OpenAI-compatible API: чаты и настройки остаются на вашей машине, без облака Harbor.</p>

    <h3>Возможности</h3>
    <ul>
      <li><b>Режимы Agent / Plan / Ask</b> — правки и терминал, план без правок, вопросы по коду</li>
      <li><b>Свой провайдер</b> — OpenAI, Azure, корпоративные gateway, локальные модели</li>
      <li><b>Инструменты</b> — поиск по проекту, чтение и правка файлов, команды в терминале</li>
      <li><b>Контекст из IDE</b> — добавить выделение или файл в чат (контекстное меню и хоткеи)</li>
      <li><b>MCP</b> — Figma и свои серверы (stdio / HTTP)</li>
      <li><b>Review и Git</b> — карточки diff, генерация commit message, commit &amp; push из панели</li>
      <li><b>Сессии локально</b> — чаты хранятся в проекте (<code>.idea/harbor</code>)</li>
    </ul>

    <h3>Быстрый старт</h3>
    <ol>
      <li>Откройте tool window <b>Harbor Agents</b></li>
      <li>Settings → добавьте провайдера (<code>baseUrl</code>, <code>apiKey</code>) и модели</li>
      <li>Выделите код → <b>⇧⌘L</b> / <b>Ctrl+Shift+L</b> — добавить в чат</li>
      <li>Файл → <b>⇧⌘H</b> / <b>Ctrl+Shift+H</b> — добавить файл в чат</li>
    </ol>

    <h3>Требования</h3>
    <ul>
      <li>WebStorm / IntelliJ <b>2025.2+</b> (build 252+) с JCEF / Web Browser</li>
      <li>Node.js для sidecar-рантайма агента</li>
      <li>OpenAI-compatible API и хотя бы один model id</li>
    </ul>
  ]]></description>

  <change-notes><![CDATA[
    <b>1.5.134</b>
    <ul>
      <li>Ветки чата: вкладки как в браузере, подпись из промпта, имя форка сразу лёгкой моделью на языке из Settings</li>
    </ul>
    <b>1.5.115</b>
    <ul>
      <li>В статусе «Думаю...» короткое имя модели (GLM 5.2)</li>
    </ul>
    <b>1.5.114</b>
    <ul>
      <li>Авто-имя чата лёгкой моделью; ручное имя не перезаписывается</li>
      <li>Превью картинок в истории; пузырь по ширине текста; шаги — чип; короткое имя модели в композере</li>
      <li>Ветки: пилюли Main / ·2; rename агента в WebStorm больше не теряется</li>
    </ul>
    <b>1.5.113</b>
    <ul>
      <li>GLM без vision: описание картинки под капотом; повторный проход только если вопрос про скрин</li>
      <li>Простаивающие Cline-сессии выгружаются при смене чата</li>
    </ul>
  ]]></change-notes>

  <!-- JCEF is on the platform classpath in 2025.2 (252). From 2025.3.1 the
       com.intellij.modules.jcef alias exists — optional so 252 still loads. -->
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <depends optional="true" config-file="harbor-jcef.xml">com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow
      id="Harbor Agents"
      anchor="right"
      icon="/icons/harbor.svg"
      factoryClass="com.harbor.agents.HarborToolWindowFactory"/>
    <notificationGroup id="Harbor Agents" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action
      id="HarborAgents.Open"
      class="com.harbor.agents.actions.OpenHarborAction"
      text="Open Harbor Agents"
      description="Open the Harbor Agents tool window">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action
      id="HarborAgents.NewChat"
      class="com.harbor.agents.actions.NewChatAction"
      text="New Chat"
      description="Start a new Harbor Agents chat"
      icon="AllIcons.General.Add"/>
    <action
      id="HarborAgents.OpenSettings"
      class="com.harbor.agents.actions.OpenSettingsAction"
      text="Settings"
      description="Open Harbor Agents settings"
      icon="AllIcons.General.Settings">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action
      id="HarborAgents.Reload"
      class="com.harbor.agents.actions.ReloadHarborAction"
      text="Reload"
      description="Reload Harbor Agents panel"
      icon="AllIcons.Actions.Refresh"/>
    <action
      id="HarborAgents.GenerateCommitMessage"
      class="com.harbor.agents.actions.GenerateCommitMessageAction"
      text="Harbor: Generate Commit Message"
      description="Generate a commit message via Harbor (LLM)"
      icon="/icons/harbor.svg">
      <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>

    <group id="HarborAgents.EditorPopupGroup" text="Harbor Agents" popup="true">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <action
        id="HarborAgents.AddSelectionToChat"
        class="com.harbor.agents.actions.AddSelectionToChatAction"
        text="Add Selection to Chat"
        description="Add the selected code to the Harbor Agents composer">
        <!-- Same as VS Code Harbor: Ctrl/Cmd+Shift+L -->
        <keyboard-shortcut keymap="$default" first-keystroke="control shift L"/>
        <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift L" replace-all="true"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift L" replace-all="true"/>
      </action>
      <action
        id="HarborAgents.AddSelectionToNewChat"
        class="com.harbor.agents.actions.AddSelectionToNewChatAction"
        text="Add Selection to New Chat"
        description="Start a new Harbor chat with the selected code">
        <!-- Same as VS Code Harbor: Ctrl/Cmd+Alt+L -->
        <keyboard-shortcut keymap="$default" first-keystroke="control alt L"/>
        <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt L" replace-all="true"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt L" replace-all="true"/>
      </action>
      <separator/>
      <action
        id="HarborAgents.AddFileToChat"
        class="com.harbor.agents.actions.AddFileToChatAction"
        text="Add File to Chat"
        description="Add the current file to the Harbor Agents composer">
        <!-- Same as VS Code Harbor: Ctrl/Cmd+Shift+H -->
        <keyboard-shortcut keymap="$default" first-keystroke="control shift H"/>
        <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift H" replace-all="true"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift H" replace-all="true"/>
      </action>
      <action
        id="HarborAgents.AddFileToNewChat"
        class="com.harbor.agents.actions.AddFileToNewChatAction"
        text="Add File to New Chat"
        description="Start a new Harbor chat with the current file">
        <!-- Same as VS Code Harbor: Ctrl/Cmd+Alt+H -->
        <keyboard-shortcut keymap="$default" first-keystroke="control alt H"/>
        <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt H" replace-all="true"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt H" replace-all="true"/>
      </action>
    </group>

    <group id="HarborAgents.ProjectViewPopupGroup" text="Harbor Agents" popup="true">
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <reference ref="HarborAgents.AddFileToChat"/>
      <reference ref="HarborAgents.AddFileToNewChat"/>
    </group>
  </actions>
</idea-plugin>
