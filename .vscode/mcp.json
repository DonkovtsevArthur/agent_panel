{
  "inputs": [
    {
      "type": "promptString",
      "id": "jira-personal-token",
      "description": "Jira JIRA_PERSONAL_TOKEN",
      "password": true
    }
  ],
  "servers": {
    "jira": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://jira.severstal.com",
        "JIRA_PERSONAL_TOKEN": "${input:jira-personal-token}"
      }
    }
  }
}
